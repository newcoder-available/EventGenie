# Server-only. NEVER prefix with NEXT_PUBLIC_ — that would ship the key to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
EVENTGENIE_MODEL=claude-opus-5-5
EVENTGENIE_EFFORT=medium

# Leave ANTHROPIC_API_KEY unset to run EventGenie against its built-in
# deterministic planner: no network calls, every screen still works.
